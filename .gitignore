# ============================================================
# ConstructAI — .gitignore
# ============================================================

# ── Python / Backend ─────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environment
venv/
.venv/
env/
ENV/

# Environment variables (NEVER commit API keys!)
backend/.env

# ── Node.js / Frontend ───────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
.npm

# Vite cache
frontend/.vite/

# ── IDE & OS ─────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Misc ─────────────────────────────────────────────────
*.tmp
*.bak
*.swp
.cache/
